generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(PLAYER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  wallet        Wallet?
  gameRounds    GameRound[]
}

// Rotating refresh tokens: the raw token is only ever returned to the client once. We
// store a hash so a stolen DB dump can't be replayed as a valid refresh token. Revoking a
// token (on rotation or reuse detection) sets revokedAt rather than deleting the row, so a
// reused-after-rotation token can still be detected and its whole family revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  ADJUSTMENT
}

// The wallet's cachedBalance is a read-optimized projection, never the source of truth.
// The source of truth is the sum of this wallet's LedgerEntry rows, which are append-only
// (no updates, no deletes) — every money movement is a permanent, auditable record.
model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency      String        @default("DEMO")
  cachedBalance BigInt        @default(0)
  version       Int           @default(0)
  updatedAt     DateTime      @updatedAt
  ledgerEntries LedgerEntry[]
  gameRounds    GameRound[]
}

model LedgerEntry {
  id        String          @id @default(uuid())
  walletId  String
  // onDelete: Cascade here is purely to let test fixtures clean up a whole user's data in
  // one delete — the app itself never deletes a User (only bans), so this never fires
  // against a real ledger. If a user-deletion flow is added later, use anonymization
  // instead of cascade delete to keep the audit trail intact.
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    BigInt
  type      LedgerEntryType
  refType   String?
  refId     String?
  createdAt DateTime        @default(now())

  @@index([walletId, createdAt])
}

// Guards money-moving endpoints (deposit/withdraw/spin) against duplicate charges from
// client retries: the same key always returns the original stored response, never
// re-executes the movement.
model IdempotencyKey {
  key          String   @id
  userId       String
  endpoint     String
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  @@index([userId, endpoint])
}

enum GameRoundState {
  STAKED
  RESOLVED
  FEATURE
  COMPLETE
}

// A round is the full outcome of one spin — base game plus, if triggered, the entire
// free-spins feature — decided atomically and in full by the engine the instant the player
// spins. state/freeSpinsRemaining track how much of that already-decided outcome the
// client has revealed so far (for resume-after-disconnect), not whether money has
// settled — money settles unconditionally in the same transaction that creates the round.
model GameRound {
  id                 String         @id @default(uuid())
  userId             String
  // onDelete: Cascade is for test-fixture cleanup only — the app never deletes a User.
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId           String
  wallet             Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  modelId            String
  modelVersion       String
  totalBet           BigInt
  state              GameRoundState
  freeSpinsRemaining Int            @default(0)
  totalWin           BigInt         @default(0)
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  spins              Spin[]

  @@index([userId, createdAt])
}

// One row per resolved spin within a round: index 0 is the base spin, 1..n are free spins
// in order. Immutable — this plus rngTraceJson is what makes a round replayable
// byte-for-byte from stored data alone.
model Spin {
  id           String    @id @default(uuid())
  roundId      String
  round        GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  index        Int
  gridJson     Json
  resultJson   Json
  rngTraceJson Json
  win          BigInt
  createdAt    DateTime  @default(now())

  @@unique([roundId, index])
  @@index([roundId])
}

// Singleton row (id is always "singleton") holding the currently active math model.
// Switching it is an audited admin action and never affects rounds already created —
// each GameRound pins its own modelId + modelVersion at creation time.
model GameConfig {
  id            String   @id @default("singleton")
  activeModelId String
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}
