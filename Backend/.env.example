# Copy to .env and fill with real local values (Backend/.env is gitignored)

DATABASE_URL="postgresql://slot_user:changeme@localhost:5432/slot_platform"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

WEB_ORIGIN="http://localhost:3000"

# Wallet money is USDT on Solana, 6 decimals (1_000_000 base units = 1 USDT).
# STARTING_DEMO_BALANCE is in USDT base units (100000000 = 100 USDT; 0 = start empty).
STARTING_DEMO_BALANCE=100000000
# MIN_BET/MAX_BET bound the in-tournament COIN stack bet (game points, ÷100), not USDT.
MIN_BET=100
MAX_BET=50000

# --- Crypto wallet (USDT / Solana) ---
# Platform treasury address: collects entry fees, funds prizes, and is shown to players as
# the deposit destination. Replace with your real Solana USDT address.
SOLANA_TREASURY_ADDRESS="TREASURYReplaceMeWithYourSolanaUsdtAddr1111"
# Solana SPL mint for USDT (mainnet).
USDT_MINT="Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"
# Reserved system user whose wallet is the internal treasury ledger account.
TREASURY_USER_EMAIL="treasury@wm.system"

# Optional — default OFF
EMAIL_ENABLED=false
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

SENTRY_DSN=""
