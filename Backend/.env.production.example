# PRODUCTION environment template for the Thirty One 31 backend.
# Copy to `.env` on the production host and fill in real values. NEVER commit the real file.
# Generate each secret fresh with:  openssl rand -hex 32

# --- Core ---
NODE_ENV=production                 # REQUIRED in prod: enables secure cookies, disables dev OTP/Swagger, locks CORS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/slot_platform

# --- Origin / CORS (must be your real HTTPS domain; in production ONLY this origin is allowed) ---
WEB_ORIGIN=https://thirtyone.example.com

# --- Secrets (rotate; do NOT reuse any value that ever touched git history) ---
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
CRED_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- Email (Resend). Rotate the key in the Resend dashboard; the old one was exposed. ---
EMAIL_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_new_resend_api_key
MAIL_FROM="Thirty One 31 <no-reply@thirtyone.example.com>"

# --- Never enable in production ---
# ALLOW_MOCK_MONEY must be unset/false (the boot guard rejects it under NODE_ENV=production).
# ALLOW_PROD_SEED must be unset (the demo seed refuses to run in production without it).
